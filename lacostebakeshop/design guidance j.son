{
  "project_name": "Lacoste Bakery",
  "theme": "Light",
  "archetype": "Elegant French Patisserie / Editorial Boutique",
  "design_philosophy": {
    "core_principles": [
      "Use generous negative space to evoke luxury.",
      "Asymmetry creates tension and interest.",
      "No rounded corners on structural elements - use sharp geometric precision.",
      "No food imagery as requested - rely on typography, negative space, and architectural/abstract imagery."
    ]
  },
  "colors": {
    "primary": "#F25C05",
    "primary_hover": "#D94F04",
    "background": "#FAF7F2",
    "surface": "#FFFFFF",
    "text_main": "#1A1A1A",
    "text_muted": "#5C5C5C",
    "accent_blue": "#002654",
    "accent_red": "#ED2939",
    "border": "#E5DFD3"
  },
  "typography": {
    "fonts": {
      "headings": "'Cormorant Garamond', serif",
      "body": "'Manrope', sans-serif"
    },
    "scale": {
      "h1": "text-5xl md:text-6xl tracking-tighter leading-none font-medium text-[#1A1A1A]",
      "h2": "text-4xl md:text-5xl tracking-tight leading-tight text-[#1A1A1A]",
      "h3": "text-2xl md:text-3xl tracking-tight text-[#1A1A1A]",
      "body": "text-base md:text-lg leading-relaxed text-[#5C5C5C]",
      "label": "text-xs uppercase tracking-[0.2em] font-bold text-[#F25C05]"
    }
  },
  "spacing_and_layout": {
    "container_padding": "px-6 md:px-12 lg:px-24",
    "section_gap": "py-24 md:py-32",
    "border_radius": "rounded-none",
    "shadows": "shadow-none, rely on 1px solid borders for separation (#E5DFD3)",
    "grid_system": "Bento-style asymmetry for gallery, dense lists for menus with generous row gaps. Use grid-cols-1 md:grid-cols-12 for complex sections."
  },
  "components": {
    "buttons": "Square edges (rounded-none), bg-[#F25C05] text-white hover:bg-[#D94F04] transition-colors duration-300 px-8 py-4 uppercase tracking-[0.1em] text-sm font-semibold. Accent buttons can use #002654.",
    "cards": "border border-[#E5DFD3] bg-white p-8 rounded-none",
    "navigation": "Sticky header: backdrop-blur-xl bg-[#FAF7F2]/90 border-b border-[#E5DFD3]/50. Ensure text has high contrast. Must have Logo, Menu links, and Cart CTA.",
    "menu_list": "Elegant typographic layout. Left-aligned item name and description, flex space-between with a subtle dotted border or plain space for the price.",
    "cart_drawer": "Right-side drawer, white background, solid borders, square buttons.",
    "gallery": "Grid layout using the placeholder/abstract images provided. Label items as 'Place' and 'Other Food' per user request."
  },
  "media": {
    "rules": "CRITICAL: NO STOCK PHOTOS OF PASTRIES OR COFFEE. Use ONLY the provided abstract/architectural images.",
